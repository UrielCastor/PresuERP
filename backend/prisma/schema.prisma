datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. BUSINESS & SETTINGS SYSTEM (SaaS Core)
// ==========================================

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PENDING
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum BillingCycle {
  FREE
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
  LIFETIME
}

model Business {
  id                 String    @id @default(uuid())
  name               String
  taxId              String    @unique // CUIT / RUT / RFC representation
  email              String?
  phone              String?
  website            String?
  address            String?
  city               String?
  state              String?
  country            String?
  zipCode            String?
  isActive           Boolean   @default(true)
  subscriptionPlan   String    @default("Professional")
  subscriptionEndsAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Settings relations
  settings       BusinessSettings?
  fiscalSettings FiscalSettings?
  posSettings    POSSettings?
  printSettings  PrintSettings?
  emailSettings  EmailSettings?
  numberSettings NumberSettings?

  // Module relations
  users              User[]
  roles              Role[]
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  categories         Category[]
  subCategories      SubCategory[]
  brands             Brand[]
  suppliers          Supplier[]
  warehouses         Warehouse[]
  warehouseTransfers WarehouseTransfer[]
  products           Product[]
  priceLists         PriceList[]
  stocks             Stock[]
  stockMovements     StockMovement[]
  inventories        Inventory[]
  customers          Customer[]
  customerAccounts   CustomerAccount[]
  customerAccountMovements CustomerAccountMovement[]
  purchases          Purchase[]
  sales              Sale[]
  paymentMethods     PaymentMethod[]
  cashRegisters      CashRegister[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  promotions         Promotion[]
  taxes              Tax[]
  documentTypes      DocumentType[]
  documentSeries     DocumentSeries[]
  attachments        Attachment[]
  ScheduledReport        ScheduledReport[]
  subscriptions          Subscription[]
  paymentAdjustmentRules PaymentAdjustmentRule[]
  integrations       BusinessIntegration[]
  fiscalConfiguration FiscalConfiguration?
  fiscalPointsOfSale  FiscalPointOfSale[]
  electronicInvoices  ElectronicInvoice[]
  fiscalCredentials   FiscalCredential[]
  fiscalErrorLogs     FiscalErrorLog[]

  @@index([taxId])
  @@index([isActive])
  @@map("businesses")
}

model Plan {
  id           String      @id @default(uuid())
  name         String      @unique
  code         String      @unique
  maxUsers     Int         @default(0) // 0 = unlimited
  maxProducts  Int         @default(0) // 0 = unlimited
  features     String?     @db.Text
  active       Boolean     @default(true)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subscriptions Subscription[]
  prices        PlanPrice[]
  invoices      Invoice[]

  @@map("plans")
}

model PlanPrice {
  id           String       @id @default(cuid())
  planId       String
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle
  price        Decimal      @db.Decimal(12, 2)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([planId])
  @@map("plan_prices")
}

model Subscription {
  id                 String   @id @default(cuid())

  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  planId             String
  plan               Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status             SubscriptionStatus
  billingCycle       BillingCycle

  startDate          DateTime
  renewalDate        DateTime?
  endDate            DateTime?
  paymentProvider    String?
  externalReference  String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoices           Invoice[]

  @@index([businessId])
  @@index([planId])
  @@map("subscriptions")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                 String   @id @default(cuid())

  subscriptionId     String
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  planId             String?
  plan               Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  planCode           String?
  planName           String?
  billingCycle       BillingCycle?
  paymentMethod      String?
  externalReference  String?

  amount             Decimal  @db.Decimal(12, 2)
  currency           String   @default("ARS")
  status             InvoiceStatus @default(PENDING)
  
  provider           String?
  providerReference  String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  paidAt             DateTime?

  @@index([subscriptionId])
  @@index([planId])
  @@map("invoices")
}

model SystemGatewayConfig {
  id                 String   @id @default(uuid())
  provider           String   @unique
  accessToken        String?  @db.Text
  publicKey          String?  @db.Text
  webhookSecret      String?  @db.Text
  environment        String   @default("SANDBOX") 
  isActive           Boolean  @default(true)
  
  lastTestStatus     String?
  lastTestAt         DateTime?
  lastTestVersion    String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("system_gateway_configs")
}

model BusinessIntegration {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider        String    // e.g. "MERCADO_PAGO", "ARCA", "WHATSAPP", "WEBHOOKS"
  type            String    // e.g. "PAYMENTS"
  credentials     Json      // Stores sensitive key-val configuration
  webhookSecret   String?   // Secret signature key from Mercado Pago per tenant
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE
  lastTestStatus  String?
  lastTestAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, provider])
  @@index([businessId])
  @@map("business_integrations")
}

model BusinessSettings {
  id                     String   @id @default(uuid())
  businessId             String   @unique
  currencyCode           String   @default("ARS") // e.g., USD, ARS, EUR
  currencySymbol         String   @default("$") // e.g., $, €, U$S
  timezone               String   @default("America/Argentina/Buenos_Aires")
  dateFormat             String   @default("DD/MM/YYYY")
  timeFormat             String   @default("24h")
  decimalSeparator       String   @default(",")
  thousandSeparator      String   @default(".")
  decimalPlaces          Int      @default(2)
  showCents              Boolean  @default(true)
  secondaryCurrencyCode  String?
  language               String   @default("es")
  logoUrl                String?
  // Inventory Settings
  allowNegativeStock     Boolean  @default(false)
  warnMinimumStock       Boolean  @default(true)
  autoDeductStock        Boolean  @default(true)
  allowManualAdjustments Boolean  @default(true)
  costingMethod          String   @default("Promedio Ponderado")
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_settings")
}

model FiscalSettings {
  id                    String    @id @default(uuid())
  businessId            String    @unique
  taxRegime             String    @default("Responsable Inscripto") // e.g. Monotributo, Responsable Inscripto
  fiscalYearStart       DateTime  @default(now())
  vatNumber             String? // Legal fiscal ID variation
  grossIncomeNumber     String? // Ingresos Brutos
  multilateralAgreement Boolean   @default(false)
  mainPointOfSale       String?
  afipEnvironment       String    @default("Testing")
  digitalCertificateUrl String?
  certificateExpiry     DateTime?
  isLocalTaxEnabled     Boolean   @default(true)
  defaultTaxRate        Decimal   @default(21.00) @db.Decimal(5, 2)
  updatedAt             DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("fiscal_settings")
}

model POSSettings {
  id                        String   @id @default(uuid())
  businessId                String   @unique
  isAutoCloseSessionEnabled Boolean  @default(false)
  maxCashLimit              Decimal  @default(0.00) @db.Decimal(12, 2)
  printReceiptAfterSale     Boolean  @default(true)
  isDiscountAllowed         Boolean  @default(true)
  maxDiscountPercentage     Decimal  @default(100.00) @db.Decimal(5, 2)
  defaultPaymentMethodId    String?
  defaultCashRegisterId     String?
  requireOpenCashRegister   Boolean  @default(true)
  allowMultipleRegisters    Boolean  @default(false)
  requireCustomerForSale    Boolean  @default(false)
  requireSellerForSale      Boolean  @default(false)
  ticketCopyCount           Int      @default(1)
  showTicketPreview         Boolean  @default(true)
  allowMixedPayments        Boolean  @default(true)
  autoRounding              Boolean  @default(false)
  updatedAt                 DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("pos_settings")
}

model PrintSettings {
  id          String   @id @default(uuid())
  businessId  String   @unique
  printerType String   @default("THERMAL") // e.g., THERMAL, LASER, INKJET
  paperWidth  String   @default("80MM") // e.g., 58MM, 80MM, A4
  fontName    String   @default("Monospace")
  headerText  String?  @db.Text
  footerText  String?  @db.Text
  logoSize    Int      @default(100) // Percentage scale
  margins     String   @default("0mm")
  showQr      Boolean  @default(false)
  showBarcode Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("print_settings")
}

model EmailSettings {
  id               String   @id @default(uuid())
  businessId       String   @unique
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPassword     String?
  senderEmail      String?
  senderName       String?
  secureConnection Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("email_settings")
}

model NumberSettings {
  id                     String   @id @default(uuid())
  businessId             String   @unique
  currentPurchaseNumber  Int      @default(1)
  currentSaleNumber      Int      @default(1)
  currentTransferNumber  Int      @default(1)
  currentInventoryNumber Int      @default(1)
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("number_settings")
}

// ==========================================
// 2. AUTHENTICATION & ACCESS (RBAC)
// ==========================================

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  isActive      Boolean  @default(true)
  isStaff       Boolean  @default(false)
  businessId    String?
  roleId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  originalName  String?
  originalEmail String?

  business           Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role               Role?               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions           RefreshToken[]
  audits             AuditLog[]
  activities         ActivityLog[]
  notifications      Notification[]
  favorites          Favorite[]
  createdTransfers   WarehouseTransfer[] @relation("CreatedByUser")
  stockMovements     StockMovement[]
  createdInventories Inventory[]
  purchases          Purchase[]
  createdSales       Sale[]              @relation("CreatedSalesByUser")
  openedSessions     CashSession[]       @relation("OpenedByUser")
  closedSessions     CashSession[]       @relation("ClosedByUser")
  cashMovements      CashMovement[]

  @@index([businessId, email])
  @@map("users")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "products:create"
  description String?
  module      String // e.g., "products"
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  businessId  String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([name, businessId])
  @@index([businessId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// 3. SYSTEM AUDIT & COMMUNICATION Logs
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  businessId String
  action     String // e.g., "USER_AUTHENTICATION"
  module     String // e.g., "AUTH"
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, module])
  @@map("audit_logs")
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String?
  businessId     String
  entityName     String // e.g., "Product"
  entityId       String
  actionType     String // e.g., "CREATE", "UPDATE", "DELETE"
  previousValues String?  @db.Text // JSON snapshot before change
  newValues      String?  @db.Text // JSON snapshot after change
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, entityName, entityId])
  @@index([businessId, createdAt])
  @@map("activity_logs")
}

model Notification {
  id         String    @id @default(uuid())
  businessId String
  userId     String? // Null if notification is sent to entire business staff
  title      String
  content    String    @db.Text
  isRead     Boolean   @default(false)
  readAt     DateTime?
  type       String    @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  createdAt  DateTime  @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, userId])
  @@index([businessId, isRead])
  @@map("notifications")
}

// ==========================================
// 4. CATALOG (Items, Brands, Suppliers)
// ==========================================

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  status      String   @default("ACTIVE")
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]
  products      Product[]

  @@unique([name, businessId])
  @@index([businessId])
  @@map("categories")
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  categoryId  String
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([name, categoryId, businessId])
  @@index([businessId])
  @@map("sub_categories")
}

model Brand {
  id          String   @id @default(uuid())
  name        String
  description String?
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([name, businessId])
  @@index([businessId])
  @@map("brands")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  taxId       String? // RUT/CUIT/RFC
  email       String?
  phone       String?
  address     String?
  contactName String?
  isActive    Boolean  @default(true)
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products  Product[]
  purchases Purchase[]

  @@unique([taxId, businessId])
  @@index([businessId])
  @@map("suppliers")
}

// ==========================================
// 5. WAREHOUSES & LOGISTICS (Transfers)
// ==========================================

model Warehouse {
  id          String   @id @default(uuid())
  name        String
  code        String?
  description String?
  address     String?
  managerName String?
  phone       String?
  email       String?
  isMain      Boolean  @default(false)
  status      String   @default("ACTIVE")
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stocks            Stock[]
  stockMovements    StockMovement[]
  transfersAsSource WarehouseTransfer[] @relation("SourceWarehouse")
  transfersAsTarget WarehouseTransfer[] @relation("TargetWarehouse")
  inventories       Inventory[]
  purchases         Purchase[]
  cashRegisters     CashRegister[]

  @@unique([code, businessId])
  @@index([businessId])
  @@map("warehouses")
}

model WarehouseTransfer {
  id                String   @id @default(uuid())
  businessId        String
  sourceWarehouseId String
  targetWarehouseId String
  status            String   @default("PENDING") // PENDING, IN_TRANSIT, COMPLETED, CANCELLED
  comments          String?  @db.Text
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business        Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse               @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse               @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  createdBy       User                    @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: Restrict)
  items           WarehouseTransferItem[]

  @@index([businessId, status])
  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id         String  @id @default(uuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@map("warehouse_transfer_items")
}

// ==========================================
// 6. PRICE LISTS SYSTEM
// ==========================================

model PriceList {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items     PriceListItem[]
  customers Customer[]

  @@unique([name, businessId])
  @@index([businessId, isActive])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(uuid())
  priceListId String
  productId   String
  price       Decimal @db.Decimal(12, 2)
  minQuantity Decimal @default(1.000) @db.Decimal(12, 3) // Bulk pricing logic

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minQuantity])
  @@map("price_list_items")
}

// ==========================================
// 7. INVENTORY COUNT & STOCK CONTROL
// ==========================================

model Stock {
  id               String   @id @default(uuid())
  businessId       String
  warehouseId      String
  productId        String
  quantity         Decimal  @default(0.000) @db.Decimal(12, 3)
  reservedQuantity Decimal  @default(0.000) @db.Decimal(12, 3)
  minimumStock     Decimal  @default(0.000) @db.Decimal(12, 3)
  maximumStock     Decimal  @default(0.000) @db.Decimal(12, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, businessId])
  @@index([productId])
  @@index([warehouseId])
  @@index([businessId])
  @@map("stocks")
}

model StockMovement {
  id              String   @id @default(uuid())
  businessId      String
  warehouseId     String
  productId       String
  userId          String
  movementType    String // ENTRY, EXIT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT, INVENTORY etc.
  quantity        Decimal  @db.Decimal(12, 3)
  stockBefore     Decimal  @db.Decimal(12, 3)
  stockAfter      Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @default(0.000) @db.Decimal(12, 3)
  totalCost       Decimal  @default(0.000) @db.Decimal(12, 3)
  referenceType   String? // SALE, PURCHASE, TRANSFER, ADJUSTMENT etc.
  referenceId     String? // transactional doc ID
  referenceNumber String? // invoice/receipt code
  reason          String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, productId])
  @@index([businessId, warehouseId])
  @@index([businessId, createdAt])
  @@map("stock_movements")
}

model Inventory {
  id          String   @id @default(uuid())
  businessId  String
  warehouseId String
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, CANCELLED
  createdById String
  comments    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     InventoryItem[]

  @@index([businessId, status])
  @@map("inventories")
}

model InventoryItem {
  id               String  @id @default(uuid())
  inventoryId      String
  productId        String
  systemQuantity   Decimal @db.Decimal(12, 3)
  physicalQuantity Decimal @db.Decimal(12, 3)
  variance         Decimal @db.Decimal(12, 3)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([inventoryId, productId])
  @@map("inventory_items")
}

// ==========================================
// 8. PRODUCTS Core
// ==========================================

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String? // unique code per business
  barcode       String? // main barcode representation
  description   String?  @db.Text
  categoryId    String
  subCategoryId String?
  brandId       String?
  supplierId    String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  hasVariations Boolean  @default(false)
  purchasePrice Decimal  @default(0.00) @db.Decimal(12, 2)
  salePrice     Decimal  @default(0.00) @db.Decimal(12, 2)
  profitMargin  Decimal  @default(30.00) @db.Decimal(5, 2)
  businessId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Framework relations
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory    SubCategory?            @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  brand          Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier       Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  barcodes       ProductBarcode[]
  priceListItems PriceListItem[]
  stocks         Stock[]
  stockMovements StockMovement[]
  transferItems  WarehouseTransferItem[]
  inventoryItems InventoryItem[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  promotionItems PromotionItem[]

  @@unique([sku, businessId])
  @@index([businessId, status])
  @@index([barcode, businessId])
  @@map("products")
}

model ProductImage {
  id         String @id @default(uuid())
  productId  String
  url        String
  orderIndex Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String
  code      String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([code, productId])
  @@map("product_barcodes")
}

enum CustomerType {
  PERSON
  COMPANY
}

model Customer {
  id                 String                  @id @default(uuid())
  businessId         String
  type               CustomerType            @default(PERSON)
  name               String
  document           String?                 // DNI / CUIT
  taxId              String?                 // Legal CUIT/RUT/RFC code
  taxCondition       String?                 // Responsable Inscripto, Monotributo, Consumidor Final, Exento, etc.
  email              String?
  phone              String?
  address            String?
  city               String?
  province           String?
  notes              String?                 @db.Text
  allowCreditAccount Boolean                 @default(false)
  creditLimit        Decimal                 @default(0.00) @db.Decimal(12, 2)
  currentDebt        Decimal                 @default(0.00) @db.Decimal(12, 2)
  active             Boolean                 @default(true)
  isActive           Boolean                 @default(true)
  defaultPriceListId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  business         Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultPriceList PriceList?                @relation(fields: [defaultPriceListId], references: [id], onDelete: SetNull)
  addresses        CustomerAddress[]
  accounts         CustomerAccount[]
  accountMovements CustomerAccountMovement[]
  sales            Sale[]

  @@unique([document, businessId])
  @@index([businessId, document])
  @@index([businessId])
  @@map("customers")
}

enum AccountMovementType {
  SALE
  PAYMENT
  ADJUSTMENT
}

model CustomerAccountMovement {
  id              String              @id @default(uuid())
  businessId      String
  customerId      String
  type            AccountMovementType // SALE, PAYMENT, ADJUSTMENT
  amount          Decimal             @db.Decimal(12, 2)
  remainingAmount Decimal             @default(0.00) @db.Decimal(12, 2)
  isSettled       Boolean             @default(false)
  settledAt       DateTime?
  description     String?             @db.Text
  referenceId     String?             // saleId, receiptId, etc.
  createdById     String?
  createdAt       DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, customerId])
  @@index([createdAt])
  @@map("customer_account_movements")
}

model CustomerAddress {
  id         String  @id @default(uuid())
  customerId String
  type       String  @default("SHIPPING") // SHIPPING, BILLING
  street     String
  city       String
  state      String
  postalCode String?
  country    String  @default("Argentina")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model CustomerAccount {
  id           String   @id @default(uuid())
  customerId   String
  businessId   String
  balance      Decimal  @default(0.00) @db.Decimal(12, 2) // positive represents credit, negative debt
  currencyCode String   @default("ARS")
  creditLimit  Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([customerId, businessId])
  @@map("customer_accounts")
}

// ==========================================
// 10. PURCHASES & INBOUND LOGISTICS
// ==========================================

model Purchase {
  id              String    @id @default(uuid())
  businessId      String
  supplierId      String
  warehouseId     String
  userId          String
  purchaseNumber  String
  documentType    String    @default("FACTURA") // FACTURA, REMITO, NOTA_CREDITO, OTRO
  documentNumber  String?
  status          String    @default("DRAFT") // DRAFT, APPROVED, CANCELLED
  paymentStatus   String    @default("PENDING") // PENDING, PARTIAL, PAID
  purchaseDate    DateTime  @default(now())
  expectedDate    DateTime?
  subtotal        Decimal   @db.Decimal(12, 2)
  discount        Decimal   @default(0.00) @db.Decimal(12, 2)
  tax             Decimal   @default(0.00) @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  notes           String?   @db.Text
  // Tax control fields (manual tax entry)
  hasInvoiceTaxes Boolean   @default(false)
  vatRate         Decimal   @default(21.00) @db.Decimal(5, 2)
  vatAmount       Decimal   @default(0.00) @db.Decimal(12, 2)
  otherTaxes      String?   @db.Text // JSON: [{name: string, type: string, value: number, amount: number}]
  invoicedTotal   Decimal?  @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier  Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     PurchaseItem[]

  @@unique([purchaseNumber, businessId])
  @@index([businessId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(12, 4)
  discount   Decimal  @default(0.00) @db.Decimal(12, 2)
  tax        Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_items")
}

// ==========================================
// 11. SALES & TICKET SYSTEM
// ==========================================

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Sale {
  id               String   @id @default(uuid())
  businessId       String
  customerId       String?
  cashSessionId    String?
  documentTypeId   String
  documentSeriesId String?
  documentNumber   Int
  status           String   @default("COMPLETED") // COMPLETED, DRAFT, CANCELLED, REFUNDED
  subtotal         Decimal  @db.Decimal(12, 2)
  discountType     String   @default("FIXED") // FIXED, PERCENTAGE
  discountValue    Decimal  @default(0.00) @db.Decimal(12, 2)
  discountAmount   Decimal  @default(0.00) @db.Decimal(12, 2)
  surchargeType    String   @default("NONE") // NONE, FIXED, PERCENTAGE
  surchargeValue   Decimal  @default(0.00) @db.Decimal(12, 2)
  surchargeAmount  Decimal  @default(0.00) @db.Decimal(12, 2)
  taxAmount        Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal  @db.Decimal(12, 2)
  notes            String?  @db.Text
  mpOrderId        String?
  mpPaymentId      String?
  paymentStatus    PaymentStatus @default(PENDING)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashSession    CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  documentType   DocumentType    @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  documentSeries DocumentSeries? @relation(fields: [documentSeriesId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("CreatedSalesByUser", fields: [createdById], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       SalePayment[]
  electronicInvoices ElectronicInvoice[]

  @@unique([documentTypeId, documentSeriesId, documentNumber, businessId])
  @@index([businessId, createdAt])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(uuid())
  saleId         String
  productId      String
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

// ==========================================
// 12. PAYMENTS & FINANCES
// ==========================================

model PaymentMethod {
  id                 String   @id @default(uuid())
  businessId         String
  name               String
  type               String   @default("CASH") // CASH, CARD, TRANSFER, DIGITAL_WALLET, CREDIT
  commissionRate     Decimal  @default(0.00) @db.Decimal(5, 4) // processing fee as decimals
  chargeRate         Decimal  @default(0.00) @db.Decimal(5, 4) // client surcharge rate
  discountRate       Decimal  @default(0.00) @db.Decimal(5, 4) // client cash discount
  installmentEnabled Boolean  @default(false)
  installmentCount   Int      @default(1)
  clearanceDays      Int      @default(0) // Time before money is settled
  isActive           Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salePayments  SalePayment[]
  cashMovements CashMovement[]

  @@unique([name, businessId])
  @@index([businessId])
  @@map("payment_methods")
}

model SalePayment {
  id                   String   @id @default(uuid())
  saleId               String
  paymentMethodId      String
  amount               Decimal  @db.Decimal(12, 2)
  transactionReference String? // Card ticket, bank transfer ID, etc
  provider             String?  // e.g. MERCADO_PAGO
  providerPaymentId    String?  // e.g. 123456789
  externalReference    String?  // e.g. saleId
  status               String?  // e.g. PENDING, APPROVED
  details              String?  @db.Text
  createdAt            DateTime @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_payments")
}

// ==========================================
// 13. REGISTERS & SHIFT MANAGEMENT
// ==========================================

model CashRegister {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  code        String
  warehouseId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  sessions  CashSession[]

  @@unique([code, businessId])
  @@index([businessId])
  @@map("cash_registers")
}

model CashSession {
  id                    String    @id @default(uuid())
  businessId            String
  cashRegisterId        String
  openedById            String
  closedById            String?
  openedAt              DateTime  @default(now())
  closedAt              DateTime?
  openingBalance        Decimal   @db.Decimal(12, 2)
  closingBalance        Decimal   @default(0.00) @db.Decimal(12, 2)
  cashTransactionsTotal Decimal   @default(0.00) @db.Decimal(12, 2)
  closingDifference     Decimal   @default(0.00) @db.Decimal(12, 2)
  status                String    @default("OPEN") // OPEN, CLOSED

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashRegister  CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedBy      User           @relation("OpenedByUser", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy      User?          @relation("ClosedByUser", fields: [closedById], references: [id], onDelete: Restrict)
  sales         Sale[]
  cashMovements CashMovement[]

  @@index([businessId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id              String   @id @default(uuid())
  businessId      String
  cashSessionId   String
  type            String // IN, OUT
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  referenceType   String? // e.g. MANUAL, SALE_PAYMENT, VENDOR_PAYMENT
  referenceId     String?
  paymentMethod   String?  @default("CASH") // CASH, MERCADO_PAGO, TRANSFER, DEBIT_CARD, CREDIT_CARD
  paymentMethodId String?
  createdById     String
  createdAt       DateTime @default(now())

  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashSession      CashSession    @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  createdByUser    User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  paymentMethodRel PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([cashSessionId])
  @@map("cash_movements")
}

// ==========================================
// 14. PROMOTIONS & MARKETING
// ==========================================

model Promotion {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  description  String?  @db.Text
  discountType String   @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT, BUY_X_GET_Y
  value        Decimal  @db.Decimal(12, 2)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    PromotionItem[]

  @@index([businessId, isActive])
  @@map("promotions")
}

model PromotionItem {
  id          String @id @default(uuid())
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@map("promotion_items")
}

// ==========================================
// 15. TAXES & DOCUMENT CUSTOM NUMERATION
// ==========================================

model Tax {
  id         String   @id @default(uuid())
  businessId String
  name       String // e.g. VAT 21, VAT 10.5, Internal tax
  code       String // e.g., IVA_21, IVA_105, EXEMPT
  percentage Decimal  @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([code, businessId])
  @@map("taxes")
}

model DocumentType {
  id         String  @id @default(uuid())
  businessId String
  name       String // e.g. Factura A, Factura B, Ticket Fiscal, Presupuesto
  code       String // INVOICE, RECEIPT, CREDIT_NOTE, DEBIT_NOTE, QUOTE, TRANSFER_NOTE
  direction  String  @default("OUTGOING") // INCOMING, OUTGOING
  isFiscal   Boolean @default(true)
  prefix     String  @default("0001")
  nextNumber Int     @default(1)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  series   DocumentSeries[]
  sales    Sale[]

  @@unique([code, businessId])
  @@map("document_types")
}

model DocumentSeries {
  id             String  @id @default(uuid())
  businessId     String
  documentTypeId String
  prefix         String // e.g., "A-0001", "B-0001", "POS-01"
  startNumber    Int     @default(1)
  currentNumber  Int     @default(1)
  isActive       Boolean @default(true)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@unique([prefix, businessId])
  @@map("document_series")
}

// ==========================================
// 16. UTILITY ENTITIES (Attachments & Favorites)
// ==========================================

model Attachment {
  id         String   @id @default(uuid())
  businessId String
  entityType String // e.g. PRODUCT_IMAGE, PURCHASE_INVOICE, SALE_RECEIPT
  entityId   String
  fileUrl    String
  fileName   String
  fileType   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, entityType, entityId])
  @@map("attachments")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  entityType String // PRODUCT, CUSTOMER
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@map("favorites")
}

model ScheduledReport {
  id         String    @id @default(uuid())
  businessId String
  type       String    @db.VarChar(50)
  frequency  String    @db.VarChar(50)
  email      String
  lastRun    DateTime?
  nextRun    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, isActive, nextRun])
  @@map("scheduled_reports")
}

model MercadoPagoWebhookLog {
  id             String   @id @default(uuid())
  businessId     String?
  saleId         String?
  eventType      String?
  resourceId     String?
  orderId        String?
  paymentId      String?
  status         String?
  signatureValid Boolean  @default(false)
  payload        Json
  processed      Boolean  @default(false)
  error          String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([resourceId])
  @@index([businessId])
  @@index([saleId])
  @@map("mercado_pago_webhook_logs")
}

model PaymentAdjustmentRule {
  id             String   @id @default(uuid())
  businessId     String
  paymentMethod  String   // CASH, CREDIT_CARD, DEBIT_CARD, MERCADOPAGO, TRANSFER
  adjustmentType String   // DISCOUNT | SURCHARGE
  valueType      String   // PERCENTAGE | FIXED
  value          Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, paymentMethod])
  @@index([businessId])
  @@map("payment_adjustment_rules")
}

// ==========================================
// 17. FACTURACIÓN ELECTRÓNICA ARCA / AFIP (ARGENTINA)
// ==========================================

model FiscalConfiguration {
  id                    String    @id @default(uuid())
  businessId            String    @unique
  enabled               Boolean   @default(false)
  environment           String    @default("HOMOLOGACION") // INACTIVA, HOMOLOGACION, PRODUCCION
  taxId                 String?   // CUIT (11 dígitos)
  businessName          String?   // Razón Social
  tradeName             String?   // Nombre Comercial
  ivaCondition          String    @default("RESPONSABLE_INSCRIPTO") // RESPONSABLE_INSCRIPTO, MONOTRIBUTO, EXENTO, CONSUMIDOR_FINAL
  iibb                  String?   // Ingresos Brutos
  province              String?   // Provincia
  fiscalAddress         String?   // Domicilio fiscal
  invoiceMode           String    @default("AUTOMATIC") // TICKET_INTERNO, AUTOMATIC, MANUAL
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  credentials FiscalCredential[]

  @@index([businessId])
  @@map("fiscal_configurations")
}

model FiscalCredential {
  id                   String   @id @default(uuid())
  businessId           String
  fiscalConfigId       String
  certificateEncrypted String   @db.Text
  privateKeyEncrypted  String?  @db.Text
  certificateExpiration DateTime?
  certificateName      String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  config   FiscalConfiguration @relation(fields: [fiscalConfigId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([fiscalConfigId])
  @@map("fiscal_credentials")
}

model FiscalPointOfSale {
  id          String   @id @default(uuid())
  businessId  String
  number      Int      // e.g. 1 (formateado como 00001)
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, number])
  @@index([businessId])
  @@map("fiscal_points_of_sale")
}

model ElectronicInvoice {
  id            String    @id @default(uuid())
  businessId    String
  saleId        String?
  voucherType   String    // FACTURA_A, FACTURA_B, FACTURA_C, NOTA_CREDITO_A, NOTA_CREDITO_B, NOTA_CREDITO_C, NOTA_DEBITO_A, NOTA_DEBITO_B, NOTA_DEBITO_C
  voucherCode   Int       // 1=Factura A, 6=Factura B, 11=Factura C, 3=NC A, 8=NC B, 13=NC C, 2=ND A, 7=ND B, 12=ND C
  pointOfSale   Int       // e.g. 1
  number        Int       // e.g. 1
  fullNumber    String    // e.g. "00001-00000001"
  cae           String?   // 14 dígitos
  caeExpiration DateTime?
  status        String    @default("PENDING") // PENDING, REQUESTED, AUTHORIZED, REJECTED, CANCELLED
  errorMessage  String?   @db.Text
  docType       Int       @default(99) // 80=CUIT, 96=DNI, 99=Consumidor Final
  docNumber     String    @default("0")
  customerName  String?
  customerIva   String?
  subtotal      Decimal   @db.Decimal(12, 2)
  vatAmount     Decimal   @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal   @db.Decimal(12, 2)
  rawRequest    Json?
  rawResponse   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale     Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  errorLogs FiscalErrorLog[]

  @@unique([businessId, pointOfSale, voucherCode, number])
  @@index([businessId, createdAt])
  @@index([saleId])
  @@index([status])
  @@map("electronic_invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(21.00) @db.Decimal(5, 2) // 21.0, 10.5, 0.0
  subtotal    Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  invoice ElectronicInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model FiscalErrorLog {
  id         String   @id @default(uuid())
  businessId String
  saleId     String?
  invoiceId  String?
  request    Json?
  response   Json?
  errorCode  String?
  message    String   @db.Text
  createdAt  DateTime @default(now())

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  ElectronicInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("fiscal_error_logs")
}



