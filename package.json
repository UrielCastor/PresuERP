{
  "name": "erp-monorepo",
  "version": "1.0.0",
  "description": "Multi-tenant ERP Web Monorepo setup",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
